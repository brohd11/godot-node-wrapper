#! namespace NodeWrapper class Profile
extends RefCounted

## Everything a consumer of the generator decides: naming, output layout, and per-base templates.
## Templates use String.format keys {wrapper}, {type}, {wrapper_type} and {factory}; owner_name stays
## literal in them and is renamed per target.

## Shown in error and status messages.
var label: String = "Node Wrapper"
## Top-level source classes with this prefix are prototypes; the rest of the name infers the type.
var prefix: String = "Sw"
## Placeholder owner class name used by every template; each target renames it.
var owner_name: String = "WrapperOwner"
## Preload alias generated files reach the owner through, so they compile before the owner's
## global class is registered. An unnamed owner uses it for itself too.
var owner_alias: String = "_WrapperOwner"
var header: String = "# Generated by NodeWrapper. Do not edit."
## Preload aliases for custom target scripts that the source doesn't already import.
var alias_prefix: String = "_WrapTarget"

## ProjectSettings key mapping output directories to owner class names.
var targets_setting: String = ""
var default_targets: Dictionary = {}
## Outputs inside this directory are rejected, so generated code never lands in the addon.
var addon_dir: String = ""

## Paths relative to each target directory.
var source_file: String = "source.gd"
var owner_file: String = "generated/owner.gd"
var classes_file: String = "generated/wrappers_generated.gd"
var statics_file: String = "generated/wrappers.gd"
## Const in the owner that preloads the statics file.
var statics_const: String = "Wrappers"

## Owner runtime source; generated factories are appended to it.
var owner_template: String = ""
## Written as the source file when a target has none.
var seed_template: String = ""

## The wrapped object's field; prototypes declare it and generated setters write through it.
var member: String = "_object"
## Native class name -> {"class": String, "factory": String, "static": String}. The most derived
## key a type inherits from supplies its templates. Empty factory/static templates emit nothing.
var bases: Dictionary = {}
